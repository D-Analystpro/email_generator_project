          "output_type": "stream",
          "text": [
            "HDFS (Hadoop Distributed File System) stores massive data across a cluster by splitting files into large blocks (default 128 MB) and replicating each block on multiple nodes for fault‑tolerance. It provides a single‑namespace, streaming‑write‑once read‑many access model that scales horizontally as you add more commodity servers.\n"
          ]
        }
      ],
      "source": [
        "llm = ChatGroq(\n",
        "    api_key=\"enter api key\",\n",
        "    model=\"openai/gpt-oss-120b\"\n",
        ")\n",
        "\n",
        "response = llm.invoke(\"Explain HDFS in 2 lines\")\n",
        "print(response.content)"
